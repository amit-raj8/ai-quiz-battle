# =============================================================================
# AI QUIZ BATTLE - SERVER ENVIRONMENT CONFIGURATION
# =============================================================================

# Gemini API Key (Server-Side Only - Never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model Selection (Defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Backend API Port
PORT=5000

# Optional: Spline 3D Scene Export URL (from Spline editor: Export -> Public URL)
# Example: https://prod.spline.design/xxxxxxxx/scene.splinecode
VITE_SPLINE_SCENE_URL=
